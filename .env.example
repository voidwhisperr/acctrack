# AccTrack environment variables
# Copy to .env only if your process manager loads it.

# HTTP server
PORT=8766
GT_BIND=127.0.0.1

# Authentication: off | basic | cloudflare
# Leave empty to use the value stored in Settings.
GT_AUTH=
GT_AUTH_USER=admin
GT_AUTH_PASS=change-me-please
GT_REQUIRE_ACCESS=0

# Data directory (default: the app folder)
# GT_DATA_DIR=/path/to/data

# Token for the optional Taobao collector agent
GT_COLLECTOR_TOKEN=

# Collector settings (taobao_collector.py)
GT_SERVER=http://127.0.0.1:8766
GT_TOKEN=
